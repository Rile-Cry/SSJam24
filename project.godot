; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Aetheria"
config/version="0.0.0"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameGlobal="*res://autoloads/general/game_global.gd"
GameGlobalEvents="*res://autoloads/general/game_global_events.gd"
MusicManager="*res://autoloads/audio/music_manager.gd"
SoundManager="*res://autoloads/audio/sound_manager.gd"
BeehaveGlobalMetrics="*res://addons/beehave/metrics/beehave_global_metrics.gd"
BeehaveGlobalDebugger="*res://addons/beehave/debug/global_debugger.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"

[dialogic]

directories/dch_directory={}
directories/dtl_directory={}

[display]

window/size/resizable=false
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/beehave/plugin.cfg", "res://addons/dialogic/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "teal",
"res://assets/": "pink",
"res://autoloads/": "yellow",
"res://gameplay/": "red",
"res://utility/": "purple"
}

